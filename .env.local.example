# Supabaseダッシュボード > Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー専用。"use client" を付けたファイルや、ブラウザに渡す値には絶対に使わないこと。
# 現時点(M1〜M3)ではコードから参照していないが、将来のadmin機能用に変数名だけ用意している。
SUPABASE_SERVICE_ROLE_KEY=

# M4: Slack Incoming Webhook URL（サーバー専用。lib/notifications/notify.ts からのみ参照する）
SLACK_WEBHOOK_URL=
